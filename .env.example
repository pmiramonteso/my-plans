# Copia este archivo a .env.local y rellénalo.
# En local: `npm run db:start` muestra la URL y la Publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nunca pongas aquí la service_role / secret key: la app no la necesita.
